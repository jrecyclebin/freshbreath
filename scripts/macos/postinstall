#!/bin/bash
# Runs as root during install (both fresh install and upgrade). Idempotent —
# safe to run once on a fresh box and again on every upgrade.
#
# Fresh install: creates the service user, makes the data dir, loads the daemon.
# Upgrade: the user and data dir already exist (the checks no-op); the daemon is
# already running the old binary, so we kickstart -k it onto the just-replaced
# binary instead of bootstrapping from scratch.
set -euo pipefail

LABEL=institute.poggers.freshbreath
PLIST=/Library/LaunchDaemons/${LABEL}.plist
DATA_DIR=/usr/local/var/freshbreath

# Create the dedicated service user + its primary group if missing. The group
# is required too: `chown _freshbreath:_freshbreath` below resolves the name via
# getgrnam, which fails (and chown with it) if the group doesn't exist. UID/GID
# is one above the highest user UID in use, floored to 200 — the local-service
# range (below per-user 500+, above the reserved <200). Same numeric ID for
# both is the macOS convention for a user's primary group. UserShell is
# /usr/bin/false: it's a service account, not one to log into; NFSHomeDir is
# the data dir so $HOME-derived XDG paths land somewhere owned by the service
# user.
if ! id _freshbreath >/dev/null 2>&1; then
  uid=$(dscl . -list /Users UniqueID 2>/dev/null | awk '{print $2}' | sort -n | tail -1)
  uid=$((uid + 1))
  [ "$uid" -lt 200 ] && uid=200
  dscl . -create /Groups/_freshbreath 2>/dev/null || true
  dscl . -create /Groups/_freshbreath PrimaryGroupID "$uid"
  dscl . -create /Groups/_freshbreath RealName "Fresh Breath"
  dscl . -create /Users/_freshbreath
  dscl . -create /Users/_freshbreath UserShell /usr/bin/false
  dscl . -create /Users/_freshbreath UniqueID "$uid"
  dscl . -create /Users/_freshbreath PrimaryGroupID "$uid"
  dscl . -create /Users/_freshbreath NFSHomeDir "$DATA_DIR"
  dscl . -create /Users/_freshbreath RealName "Fresh Breath"
fi

# Data dir (DB, apps, logs). Never shipped in the pkg, so it survives upgrades
# untouched — the same principle as the Windows installer leaving
# %PROGRAMDATA%\freshbreath alone. Owned by the service user the daemon runs as.
mkdir -p "$DATA_DIR"
chown -R _freshbreath:_freshbreath "$DATA_DIR"

# (Re)load the daemon. If it's already loaded (an upgrade — the old binary is
# running), kickstart -k kills and restarts it against the new binary. If not
# (a fresh install), bootstrap loads and starts it. Either path leaves the
# daemon running the binary the pkg just laid down.
if launchctl print system/"$LABEL" >/dev/null 2>&1; then
  launchctl kickstart -k system/"$LABEL"
else
  launchctl bootstrap system "$PLIST"
fi

cat <<EOF
Fresh Breath installed.
  Server:    http://localhost:9009
  Data:      $DATA_DIR
  Logs:      $DATA_DIR/freshbreath.log
  Uninstall: sudo /usr/local/freshbreath/uninstall.sh
EOF
