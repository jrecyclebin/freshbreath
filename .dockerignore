# The image is built from a release tarball, so the context is dist/ and
# nothing else. Everything below is source (already inside the tarball),
# local state, or an agent's scratch drawer.

*
!dist/*.tar.gz

# Belt and braces — the ignores below predate the tarball approach and cost
# nothing to keep, in case that `*` ever softens.

.git
.github
.journal
.claude
.todos/
.sidecar*
.mcp.json
.td-root

freshbreath
*.db
*.db-wal
*.db-shm
*.pem
.env

apps/
data/
tasks/
virtual/
tmp/
design/
samples/
static.html

Dockerfile
.dockerignore
docker-compose.yml
